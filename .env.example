# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_VERSION=v1

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Redis (optional) ──────────────────────────────────────────────────────────
REDIS_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Storage ───────────────────────────────────────────────────────────────────
# STORAGE_MODE: local (dev only) | r2 (Cloudflare, preferred) | s3 (AWS, legacy)
STORAGE_MODE=local
UPLOADS_DIR=uploads

# ── Cloudflare R2 (set STORAGE_MODE=r2) ──────────────────────────────────────
# Setup steps:
#   1. Cloudflare Dashboard → R2 → Create bucket (e.g. digital-sangha-assets)
#   2. R2 → Manage R2 API Tokens → Create token with Object Read & Write on the bucket
#   3. Bucket Settings → Public Access → Allow (or add custom domain)
#      Custom domain: Settings → Custom domains → assets.sangham.online (CNAME via Cloudflare DNS)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=digital-sangha-assets
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
# With custom domain: R2_PUBLIC_URL=https://assets.sangham.online

# ── AWS S3 (set STORAGE_MODE=s3) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# ── CORS ──────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=https://sangham.online

# ── Razorpay (Dhamma Daan payments) ──────────────────────────────────────────
# Test keys: razorpay.com/docs/payments/dashboard/settings/api-keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── Agora (live sessions) ─────────────────────────────────────────────────────
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ── Email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=namo@sangham.online

# ── Twilio OTP ────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
