// ─────────────────────────────────────────────────────────────────────────────
// Sangham — Prisma Schema
// Version: 0.1.0  |  DB: PostgreSQL 15
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled connection — used by the app
  directUrl = env("DIRECT_URL")     // direct connection — used by prisma migrate
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  GUEST
  PRACTITIONER
  TRUSTED
  BHIKKHU
  BHIKKHUNI
  SCHOLAR
  ASSOCIATION_ADMIN
  MODERATOR
  SUPER_ADMIN
}

enum Tradition {
  THERAVADA
  MAHAYANA
  VAJRAYANA
  NAVAYANA
  OTHER
  MULTIPLE
}

enum PostType {
  TEXT
  IMAGE
  AUDIO
  LINK
  QUOTE
}

enum SessionType {
  DHARMA_TALK
  GUIDED_MEDITATION
  SUTTA_STUDY
  QA
  CEREMONY
  TELECAST
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum EventType {
  RETREAT
  CEREMONY
  TALK
  SEMINAR
  PROTEST_MARCH
  COMMUNITY_GATHERING
  DHAMMA_DIKSHA
  CONVERSION_CEREMONY
  AMBEDKAR_JAYANTI
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

enum AssociationCategory {
  TEMPLE
  NGO
  STUDY_GROUP
  AMBEDKARITE_SANGHA
  UNIVERSITY_CLUB
  NATIONAL_FEDERATION
  INTERNATIONAL_BODY
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContentLicence {
  CC0
  CC_BY
  CC_BY_SA
  CC_BY_NC
  CC_BY_NC_ND
  PUBLIC_DOMAIN
  MIXED
}

// ── User ─────────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid())
  email             String?    @unique
  phone             String?    @unique
  firebaseUid       String?    @unique @map("firebase_uid")
  displayName       String     @map("display_name")
  bio               String?    @db.VarChar(500)
  profilePhoto      String?    @map("profile_photo")
  coverImage        String?    @map("cover_image")
  country           String?    // ISO 3166-1 alpha-2
  city              String?
  traditions        Tradition[]
  role              UserRole   @default(PRACTITIONER)
  isVerifiedClergy  Boolean    @default(false) @map("is_verified_clergy")
  languages         String[]   // ISO 639-1 codes
  preferredLanguage String     @default("en") @map("preferred_language")
  templeAffiliation String?    @map("temple_affiliation")
  passwordHash      String?    @map("password_hash")
  isActive          Boolean    @default(true) @map("is_active")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  lastActiveAt      DateTime?  @map("last_active_at")
  publicKey         String?    @db.Text @map("public_key")  // E2E: SPKI P-256 public key, base64

  // Relations
  posts             Post[]
  sessions          LiveSession[]   @relation("SessionHost")
  sessionRsvps      SessionAttendee[]
  events            Event[]         @relation("EventOrganiser")
  eventRsvps        EventRsvp[]
  associations      AssociationMember[]
  sentMessages      Message[]       @relation("MessageSender")
  receivedMessages  Message[]       @relation("MessageReceiver")
  bookmarks         Bookmark[]
  annotations       Annotation[]
  followers         Follow[]        @relation("Followed")
  following         Follow[]        @relation("Follower")
  blocksMade        Block[]         @relation("Blocker")
  blocksReceived    Block[]         @relation("Blocked")
  clergyApplication ClergyApplication?
  moderationActions ModerationAction[]
  location          UserLocation?
  tags              UserTag[]
  intents           Intent[]
  intentResponses   IntentResponse[]
  privacySettings   PrivacySettings?
  contributionScore ContributionScore?
  teacherVerification TeacherVerification?
  isVerifiedTeacher Boolean   @default(false) @map("is_verified_teacher")
  isContributor     Boolean   @default(false) @map("is_contributor")
  contributorSince  DateTime? @map("contributor_since")
  professionType    ProfessionType? @map("profession_type")
  customProfession  String?         @map("custom_profession") @db.VarChar(100)
  interestTags      String[]        @default([]) @map("interest_tags")
  intentTags        String[]        @default([]) @map("intent_tags")

  daanContributions   DhammaDaanContribution[]
  readingProgress     ReadingProgress[]
  highlights          Highlight[]
  projectsOwned        Project[]          @relation("ProjectOwner")
  projectMemberships   ProjectMember[]
  resourcesContributed Resource[]         @relation("ResourceContributor")
  coursesInstructed    Course[]           @relation("CourseInstructor")
  courseEnrollments    CourseEnrollment[]
  studyCirclesFacilitated StudyCircle[]   @relation("StudyCircleFacilitator")
  studyCircleMemberships StudyCircleMember[]
  discussionPosts      DiscussionPost[]   @relation("DiscussionPostAuthor")
  educateEnrollments   EducateEnrollment[]
  educateReputation    EducateUserReputation?

  @@map("users")
}

// ── Follow ───────────────────────────────────────────────────────────────────

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followedId  String   @map("followed_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed    User     @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@map("follows")
}

model Block {
  blockerId   String   @map("blocker_id")
  blockedId   String   @map("blocked_id")
  createdAt   DateTime @default(now()) @map("created_at")

  blocker     User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// ── Clergy Verification ───────────────────────────────────────────────────────

model ClergyApplication {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  ordinationDoc      String?            @map("ordination_doc") // S3 URL
  abbotLetter        String?            @map("abbot_letter")   // S3 URL
  templeAffiliation  String             @map("temple_affiliation")
  vinayaTradition    String             @map("vinaya_tradition")
  notes              String?
  status             VerificationStatus @default(PENDING)
  reviewedBy         String?            @map("reviewed_by")
  reviewedAt         DateTime?          @map("reviewed_at")
  rejectionReason    String?            @map("rejection_reason")
  createdAt          DateTime           @default(now()) @map("created_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("clergy_applications")
}

// ── Posts & Feed ─────────────────────────────────────────────────────────────

model Post {
  id             String    @id @default(uuid())
  authorId       String    @map("author_id")
  content        String?   @db.VarChar(1000)
  postType       PostType  @default(TEXT) @map("post_type")
  mediaUrls      String[]  @map("media_urls")
  linkUrl        String?   @map("link_url")
  linkPreview    Json?     @map("link_preview") // title, description, image
  traditionTags  Tradition[] @map("tradition_tags")
  libraryRefId   String?   @map("library_ref_id") // FK to LibrarySegment
  isBhikkhuPost  Boolean   @default(false) @map("is_bhikkhu_post")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  author         User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments       Comment[]
  likes          Like[]
  reports        ContentReport[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  content   String   @db.VarChar(500)
  parentId  String?  @map("parent_id") // for threading
  createdAt DateTime @default(now()) @map("created_at")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("likes")
}

// ── Knowledge Library ─────────────────────────────────────────────────────────

model LibraryCollection {
  id          String         @id @default(uuid())
  slug        String         @unique // stable external key, e.g. "suttacentral-tipitaka"
  name        String         // e.g., "Tipitaka", "BAWS", "Dhammapada"
  tradition   Tradition
  description String?        @db.Text
  sourceUrl   String?        @map("source_url")
  licence     ContentLicence
  isActive    Boolean        @default(true) @map("is_active")

  texts       LibraryText[]

  @@map("library_collections")
}

model LibraryText {
  id           String             @id @default(uuid())
  collectionId String             @map("collection_id")
  externalId   String?            @unique @map("external_id") // e.g., "mn1" from SuttaCentral
  title        String
  author       String?
  translator   String?
  language     String             // ISO 639-1
  licence      ContentLicence
  sourceUrl    String             @map("source_url")
  coverUrl     String?            @map("cover_url")
  attribution  String             // Full attribution string to display
  isSearchable Boolean            @default(true) @map("is_searchable")
  createdAt    DateTime           @default(now()) @map("created_at")

  collection       LibraryCollection  @relation(fields: [collectionId], references: [id])
  segments         LibrarySegment[]
  bookmarks        Bookmark[]
  readingProgress  ReadingProgress[]
  highlights       Highlight[]

  @@index([collectionId])
  @@index([language])
  @@map("library_texts")
}

model LibrarySegment {
  id          String   @id @default(uuid())
  textId      String   @map("text_id")
  segmentKey  String   @map("segment_key") // e.g., "mn1:1.1"
  content     String   @db.Text
  verseNumber Int?     @map("verse_number")
  chapterRef  String?  @map("chapter_ref")
  sequence    Int      // ordering within text

  text        LibraryText   @relation(fields: [textId], references: [id], onDelete: Cascade)
  annotations Annotation[]
  highlights  Highlight[]

  @@unique([textId, segmentKey])
  @@index([textId])
  @@map("library_segments")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  textId    String   @map("text_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      LibraryText @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@unique([userId, textId])
  @@map("bookmarks")
}

model Annotation {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  segmentId   String   @map("segment_id")
  content     String   @db.VarChar(1000)
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment     LibrarySegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@map("annotations")
}

model ReadingProgress {
  id               String      @id @default(uuid())
  userId           String      @map("user_id")
  textId           String      @map("text_id")
  currentSegment   Int         @default(0) @map("current_segment")
  percentComplete  Decimal     @default(0) @db.Decimal(5,2) @map("percent_complete")
  isCompleted      Boolean     @default(false) @map("is_completed")
  lastReadAt       DateTime    @default(now()) @map("last_read_at")
  timeSpentSeconds Int         @default(0) @map("time_spent_seconds")

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  text             LibraryText @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@unique([userId, textId])
  @@index([userId])
  @@map("reading_progress")
}

model Highlight {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  textId       String         @map("text_id")
  segmentId    String         @map("segment_id")
  selectedText String         @db.Text @map("selected_text")
  color        String         @default("#FEF08A")
  note         String?        @db.VarChar(1000)
  isPublic     Boolean        @default(false) @map("is_public")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         LibraryText    @relation(fields: [textId], references: [id], onDelete: Cascade)
  segment      LibrarySegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@index([userId, textId])
  @@map("highlights")
}

// ── Live Sessions ─────────────────────────────────────────────────────────────

model LiveSession {
  id             String        @id @default(uuid())
  hostId         String        @map("host_id")
  title          String
  description    String?       @db.Text
  sessionType    SessionType   @map("session_type")
  traditionTag   Tradition?    @map("tradition_tag")
  language       String        @default("en")
  scheduledAt    DateTime      @map("scheduled_at")
  startedAt      DateTime?     @map("started_at")
  endedAt        DateTime?     @map("ended_at")
  agoraChannel   String        @unique @map("agora_channel")
  recordingUrl   String?       @map("recording_url")
  maxViewers     Int           @default(0) @map("max_viewers") // 0 = unlimited
  rsvpRequired   Boolean       @default(false) @map("rsvp_required")
  status         SessionStatus @default(SCHEDULED)
  createdAt      DateTime      @default(now()) @map("created_at")

  host           User          @relation("SessionHost", fields: [hostId], references: [id])
  attendees      SessionAttendee[]

  @@index([scheduledAt])
  @@index([status])
  @@map("live_sessions")
}

model SessionAttendee {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  joinedAt  DateTime @default(now()) @map("joined_at")
  leftAt    DateTime? @map("left_at")

  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_attendees")
}

// ── Events ────────────────────────────────────────────────────────────────────

model Event {
  id              String    @id @default(uuid())
  organiserId     String    @map("organiser_id")
  associationId   String?   @map("association_id")
  title           String
  description     String?   @db.Text
  eventType       EventType @map("event_type")
  traditionTag    Tradition? @map("tradition_tag")
  startsAt        DateTime  @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  timezone        String    // IANA timezone
  locationName    String?   @map("location_name")
  lat             Decimal?  @db.Decimal(10, 7)
  lng             Decimal?  @db.Decimal(10, 7)
  onlineUrl       String?   @map("online_url")
  capacity        Int       @default(0) // 0 = unlimited
  isRecurring     Boolean   @default(false) @map("is_recurring")
  recurrenceRule  String?   @map("recurrence_rule") // RRULE format
  isPublished     Boolean   @default(true) @map("is_published")
  createdAt       DateTime  @default(now()) @map("created_at")

  organiser       User      @relation("EventOrganiser", fields: [organiserId], references: [id])
  association     Association? @relation(fields: [associationId], references: [id])
  rsvps           EventRsvp[]
  studyCircles    StudyCircle[]

  @@index([startsAt])
  @@index([lat, lng])
  @@map("events")
}

model EventRsvp {
  id        String     @id @default(uuid())
  eventId   String     @map("event_id")
  userId    String     @map("user_id")
  status    RsvpStatus
  createdAt DateTime   @default(now()) @map("created_at")

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_rsvps")
}

// ── Associations ──────────────────────────────────────────────────────────────

model Association {
  id               String              @id @default(uuid())
  name             String
  country          String
  city             String?
  tradition        Tradition
  category         AssociationCategory
  parentId         String?             @map("parent_id")
  legalRegNumber   String?             @map("legal_reg_number")
  description      String?             @db.Text
  website          String?
  isVerified       Boolean             @default(false) @map("is_verified")
  verifiedAt       DateTime?           @map("verified_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  parent           Association?        @relation("FederationHierarchy", fields: [parentId], references: [id])
  children         Association[]       @relation("FederationHierarchy")
  members          AssociationMember[]
  events           Event[]
  projects         Project[]
  modules          CommunityModule?
  resources        Resource[]
  courses          Course[]
  studyCircles     StudyCircle[]

  @@map("associations")
}

model AssociationMember {
  id              String   @id @default(uuid())
  associationId   String   @map("association_id")
  userId          String   @map("user_id")
  memberRole      String   @default("MEMBER") @map("member_role") // PRESIDENT, SECRETARY, TREASURER, CORE, MEMBER
  joinedAt        DateTime @default(now()) @map("joined_at")
  isActive        Boolean  @default(true) @map("is_active")

  association     Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([associationId, userId])
  @@map("association_members")
}

// ── Messages (DMs) ────────────────────────────────────────────────────────────

model Message {
  id           String   @id @default(uuid())
  senderId     String   @map("sender_id")
  recipientId  String   @map("recipient_id")
  ciphertext   String   @db.Text // E2E: AES-GCM ciphertext, base64
  iv           String?  @db.VarChar(24) @map("iv")          // E2E: AES-GCM IV, base64 (null = legacy plaintext)
  type         String   @default("text") @db.VarChar(20)
  mediaUrl     String?  @map("media_url") @db.Text
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  sender       User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User     @relation("MessageReceiver", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId])
  @@index([createdAt])
  @@map("messages")
}

// ── Moderation ────────────────────────────────────────────────────────────────

model ContentReport {
  id          String   @id @default(uuid())
  reporterId  String   @map("reporter_id")
  postId      String?  @map("post_id")
  reason      String
  details     String?  @db.VarChar(500)
  isResolved  Boolean  @default(false) @map("is_resolved")
  createdAt   DateTime @default(now()) @map("created_at")

  post        Post?    @relation(fields: [postId], references: [id])

  @@map("content_reports")
}

model ModerationAction {
  id          String   @id @default(uuid())
  moderatorId String   @map("moderator_id")
  targetId    String   @map("target_id")
  targetType  String   @map("target_type") // user, post, comment
  action      String   // warn, remove, ban
  reason      String
  createdAt   DateTime @default(now()) @map("created_at")

  moderator   User     @relation(fields: [moderatorId], references: [id])

  @@map("moderation_actions")
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String   // follow, like, comment, session_reminder, event_reminder
  title     String
  body      String
  data      Json?    // Extra context (postId, sessionId etc.)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════
// EXTENSION — 8 Strategic Priorities (v2)
// ═══════════════════════════════════════════════════════════════════════

// ── Priority 1 + 6: People Discovery + Hyperlocal ─────────────────────

enum ApproximateDistance {
  WITHIN_2KM
  WITHIN_5KM
  WITHIN_10KM
  SAME_CITY
  SAME_STATE
  SAME_COUNTRY
}

enum LocationVisibility {
  HIDDEN
  APPROXIMATE   // shows "Within 5km", never exact coords
  CITY_ONLY
  STATE_ONLY
  COUNTRY_ONLY
}

// Fuzzy location — NEVER store exact lat/lng for privacy
// Snap to city/area grid only
model UserLocation {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  country            String?            // ISO 3166-1 alpha-2
  state              String?            // e.g. "Maharashtra"
  city               String?            // e.g. "Mumbai"
  area               String?            // e.g. "Dadar" — optional hyperlocal
  // Snapped grid cell (1km precision, NOT exact)
  gridLat            Decimal?           @db.Decimal(4,1) @map("grid_lat")
  gridLng            Decimal?           @db.Decimal(4,1) @map("grid_lng")
  visibility         LocationVisibility @default(CITY_ONLY)
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")
}

// ── Priority 5 + 6: Professional & Interest Tags ──────────────────────

enum ProfessionType {
  STUDENT
  TEACHER
  RESEARCHER
  DOCTOR
  ENGINEER
  LAWYER
  BUSINESS_OWNER
  ENTREPRENEUR
  ARTIST
  WRITER
  ACTIVIST
  CIVIL_SERVANT
  EMPLOYEE
  MONK_NUN
  VOLUNTEER
  OTHER
}

enum ProfessionalTag {
  ENTREPRENEUR
  FOUNDER
  STUDENT
  DEVELOPER
  RESEARCHER
  TRANSLATOR
  VOLUNTEER
  TEACHER
  ARTIST
  WRITER
  CIVIL_SERVANT
  PROFESSIONAL
  ACTIVIST
  MEDITATOR
  CAREGIVER
  RETIRED
}

model UserTag {
  id      String          @id @default(uuid())
  userId  String          @map("user_id")
  tag     ProfessionalTag

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@map("user_tags")
}

// ── Priority 2: Intent-Based Networking ───────────────────────────────

enum IntentCategory {
  MEDITATION_PARTNER
  STUDY_GROUP
  LOCAL_SANGHA
  SEEKING_VOLUNTEERS
  SEEKING_TRANSLATORS
  BUDDHIST_FOUNDERS
  BHIKKHU_GUIDANCE
  EVENT_COLLABORATORS
  DHARMA_DISCUSSION
  LANGUAGE_EXCHANGE
  MENTORSHIP
  SKILL_SHARE
}

enum IntentStatus {
  OPEN
  CLOSED
  FULFILLED
}

enum IntentScope {
  NEARBY         // uses hyperlocal
  CITY
  STATE
  COUNTRY
  GLOBAL
}

model Intent {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  title        String         @db.VarChar(120)
  category     IntentCategory
  description  String?        @db.VarChar(500)
  scope        IntentScope    @default(CITY)
  visibility   VisibilityLevel @default(COMMUNITY)
  status       IntentStatus   @default(OPEN)
  expiresAt    DateTime?      @map("expires_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses    IntentResponse[]

  @@index([category, status])
  @@index([userId])
  @@map("intents")
}

model IntentResponse {
  id        String   @id @default(uuid())
  intentId  String   @map("intent_id")
  userId    String   @map("user_id")
  message   String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  intent    Intent   @relation(fields: [intentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([intentId, userId])
  @@map("intent_responses")
}

// ── Priority 3: Privacy-First Networking ──────────────────────────────

enum VisibilityLevel {
  PUBLIC
  COMMUNITY     // logged-in users
  CONNECTIONS   // mutual follows only
  ANONYMOUS     // browse without revealing identity
}

enum MessagingPermission {
  EVERYONE
  CONNECTIONS_ONLY
  NOBODY
}

model PrivacySettings {
  id                    String              @id @default(uuid())
  userId                String              @unique @map("user_id")
  profileVisibility     VisibilityLevel     @default(COMMUNITY) @map("profile_visibility")
  messagingPermission   MessagingPermission @default(CONNECTIONS_ONLY) @map("messaging_permission")
  locationVisibility    LocationVisibility  @default(CITY_ONLY) @map("location_visibility")
  activityVisibility    VisibilityLevel     @default(COMMUNITY) @map("activity_visibility")
  showInDiscovery       Boolean             @default(true) @map("show_in_discovery")
  anonymousBrowsing     Boolean             @default(false) @map("anonymous_browsing")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

// ── Priority 4: Contribution-Based Reputation ─────────────────────────

model ContributionScore {
  id                      String   @id @default(uuid())
  userId                  String   @unique @map("user_id")
  // Event contributions
  eventsHosted            Int      @default(0) @map("events_hosted")
  // Volunteer
  volunteerContributions  Int      @default(0) @map("volunteer_contributions")
  // Community
  communitiesCreated      Int      @default(0) @map("communities_created")
  // Knowledge
  helpfulAnswers          Int      @default(0) @map("helpful_answers")
  translationContributions Int     @default(0) @map("translation_contributions")
  libraryAnnotations      Int      @default(0) @map("library_annotations")
  // Sessions
  sessionsHosted          Int      @default(0) @map("sessions_hosted")
  // Knowledge ecosystem
  resourcesShared          Int      @default(0) @map("resources_shared")
  coursesCreated           Int      @default(0) @map("courses_created")
  studyCirclesFacilitated  Int      @default(0) @map("study_circles_facilitated")
  projectsJoined           Int      @default(0) @map("projects_joined")
  // Total (computed column — updated by job)
  totalScore              Int      @default(0) @map("total_score")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contribution_scores")
}

// ── Priority 7: Host vs Teacher distinction ───────────────────────────

enum TeacherVerificationStatus {
  NOT_APPLIED
  PENDING
  VERIFIED
  REJECTED
}

// ── Dhamma Daan (P5) ─────────────────────────────────────────────────────────

enum ContributionStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

enum AllocationCategory {
  TRANSLATION
  EDUCATION
  STUDENT_SUPPORT
  COMMUNITY_DEV
  LITERATURE
  DIGITAL_INFRA
  RESEARCH
  SOCIAL_SERVICE
  EVENTS
}

model DhammaDaanContribution {
  id                  String             @id @default(uuid())
  userId              String             @map("user_id")
  amountPaise         Int                @map("amount_paise")          // in paise (₹ × 100)
  currency            String             @default("INR")
  razorpayOrderId        String?            @unique @map("razorpay_order_id")
  razorpaySubscriptionId String?            @unique @map("razorpay_subscription_id")
  isMonthly              Boolean            @default(false) @map("is_monthly")
  razorpayPaymentId      String?            @map("razorpay_payment_id")
  razorpaySignature      String?            @map("razorpay_signature")
  status                 ContributionStatus @default(PENDING)
  splitPlatformPaise     Int                @map("split_platform_paise")
  splitFundPaise         Int                @map("split_fund_paise")
  createdAt              DateTime           @default(now()) @map("created_at")
  capturedAt             DateTime?          @map("captured_at")

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dhamma_daan_contributions")
}

model DhammaDaanAllocation {
  id            String             @id @default(uuid())
  title         String
  description   String             @db.Text
  category      AllocationCategory
  amountPaise   Int                @map("amount_paise")
  currency      String             @default("INR")
  beneficiary   String?
  impactReport  String?            @map("impact_report") @db.Text
  allocatedAt   DateTime           @default(now()) @map("allocated_at")
  createdBy     String             @map("created_by")

  @@map("dhamma_daan_allocations")
}

// ── Projects ──────────────────────────────────────────────────────────────────

enum ProjectStatus {
  OPEN
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectCategory {
  TRANSLATION
  EDUCATION
  VOLUNTEER
  RESEARCH
  TECHNOLOGY
  ENVIRONMENT
  SOCIAL_IMPACT
  COMMUNITY_BUILDING
  ARTS_CULTURE
  HEALTHCARE
}

model Project {
  id                 String          @id @default(uuid())
  ownerId            String          @map("owner_id")
  associationId      String?         @map("association_id")
  title              String          @db.VarChar(200)
  purpose            String          @db.VarChar(500)
  description        String?         @db.Text
  category           ProjectCategory
  skillsNeeded       String[]        @map("skills_needed")
  participantsNeeded Int             @default(0) @map("participants_needed")
  deadline           DateTime?
  status             ProjectStatus   @default(OPEN)
  isPublished        Boolean         @default(true) @map("is_published")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  owner              User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  association        Association?     @relation(fields: [associationId], references: [id])
  members            ProjectMember[]
  resources          Resource[]
  thread             DiscussionThread?

  @@index([status])
  @@index([ownerId])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      String   @default("CONTRIBUTOR") @map("role")
  joinedAt  DateTime @default(now()) @map("joined_at")
  isActive  Boolean  @default(true) @map("is_active")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ── Community Knowledge Ecosystem ────────────────────────────────────────────

enum ResourceType {
  YOUTUBE_VIDEO
  YOUTUBE_PLAYLIST
  PDF
  ARTICLE
  RESEARCH_PAPER
  WORKSHOP_RECORDING
  GUIDE
  BOOK_SUMMARY
}

enum CourseOwnerType {
  INDIVIDUAL
  COMMUNITY
  ORGANIZATION
  SANGHAM
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StudyCircleStatus {
  OPEN
  ACTIVE
  CLOSED
}

model CommunityModule {
  id                   String      @id @default(uuid())
  associationId        String      @unique @map("association_id")
  learningEnabled      Boolean     @default(true)  @map("learning_enabled")
  projectsEnabled      Boolean     @default(true)  @map("projects_enabled")
  circlesEnabled       Boolean     @default(true)  @map("circles_enabled")
  contributionEnabled  Boolean     @default(true)  @map("contribution_enabled")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  association          Association @relation(fields: [associationId], references: [id], onDelete: Cascade)

  @@map("community_modules")
}

model Resource {
  id             String       @id @default(uuid())
  type           ResourceType
  title          String       @db.VarChar(200)
  description    String?      @db.Text
  url            String       @db.Text
  thumbnailUrl   String?      @map("thumbnail_url") @db.Text
  creator        String?      @db.VarChar(200)
  durationSecs   Int?         @map("duration_secs")
  language       String       @default("en")
  contributorId  String       @map("contributor_id")
  associationId  String?      @map("association_id")
  projectId      String?      @map("project_id")
  isPublished    Boolean      @default(true) @map("is_published")
  createdAt      DateTime     @default(now()) @map("created_at")

  contributor    User         @relation("ResourceContributor", fields: [contributorId], references: [id], onDelete: Cascade)
  association    Association? @relation(fields: [associationId], references: [id], onDelete: SetNull)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lessons        CourseLesson[]
  thread         DiscussionThread?

  @@index([associationId])
  @@index([type])
  @@map("resources")
}

model Course {
  id             String          @id @default(uuid())
  ownerType      CourseOwnerType @default(COMMUNITY) @map("owner_type")
  ownerId        String          @map("owner_id")
  associationId  String?         @map("association_id")
  title          String          @db.VarChar(200)
  description    String?         @db.Text
  instructorId   String?         @map("instructor_id")
  language       String          @default("en")
  status         CourseStatus    @default(DRAFT)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  association    Association?    @relation(fields: [associationId], references: [id], onDelete: Cascade)
  instructor     User?           @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  lessons        CourseLesson[]
  enrollments    CourseEnrollment[]
  thread         DiscussionThread?

  @@index([associationId])
  @@index([ownerType, ownerId])
  @@map("courses")
}

model CourseEnrollment {
  id         String   @id @default(uuid())
  courseId   String   @map("course_id")
  userId     String   @map("user_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
  @@map("course_enrollments")
}

model CourseLesson {
  id           String   @id @default(uuid())
  courseId     String   @map("course_id")
  title        String   @db.VarChar(200)
  content      String?  @db.Text
  resourceId   String?  @map("resource_id")
  sequence     Int      @default(0)
  isPublished  Boolean  @default(true) @map("is_published")

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@map("course_lessons")
}

model StudyCircle {
  id                  String            @id @default(uuid())
  associationId       String            @map("association_id")
  topic               String            @db.VarChar(200)
  description         String?           @db.Text
  facilitatorId       String            @map("facilitator_id")
  scheduleDescription String?           @map("schedule_description") @db.VarChar(300)
  status              StudyCircleStatus @default(OPEN)
  eventId             String?           @map("event_id")
  createdAt           DateTime          @default(now()) @map("created_at")

  association         Association       @relation(fields: [associationId], references: [id], onDelete: Cascade)
  facilitator         User              @relation("StudyCircleFacilitator", fields: [facilitatorId], references: [id], onDelete: Cascade)
  event               Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  members             StudyCircleMember[]
  thread              DiscussionThread?

  @@index([associationId])
  @@map("study_circles")
}

model StudyCircleMember {
  id            String      @id @default(uuid())
  studyCircleId String      @map("study_circle_id")
  userId        String      @map("user_id")
  joinedAt      DateTime    @default(now()) @map("joined_at")

  studyCircle   StudyCircle @relation(fields: [studyCircleId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyCircleId, userId])
  @@map("study_circle_members")
}

model DiscussionThread {
  id            String   @id @default(uuid())
  title         String   @db.VarChar(200)
  courseId      String?  @unique @map("course_id")
  resourceId    String?  @unique @map("resource_id")
  studyCircleId String?  @unique @map("study_circle_id")
  projectId     String?  @unique @map("project_id")
  createdAt     DateTime @default(now()) @map("created_at")

  course        Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resource      Resource?    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  studyCircle   StudyCircle? @relation(fields: [studyCircleId], references: [id], onDelete: Cascade)
  project       Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  posts         DiscussionPost[]

  @@map("discussion_threads")
}

model DiscussionPost {
  id        String   @id @default(uuid())
  threadId  String   @map("thread_id")
  authorId  String   @map("author_id")
  content   String   @db.VarChar(2000)
  parentId  String?  @map("parent_id")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User             @relation("DiscussionPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("discussion_posts")
}

model TeacherVerification {
  id               String                    @id @default(uuid())
  userId           String                    @unique @map("user_id")
  credentials      String                    @db.Text  // description of qualifications
  supportingDocUrl String?                   @map("supporting_doc_url")
  lineage          String?
  status           TeacherVerificationStatus @default(NOT_APPLIED)
  reviewedBy       String?                   @map("reviewed_by")
  reviewedAt       DateTime?                 @map("reviewed_at")
  rejectionReason  String?                   @map("rejection_reason")
  createdAt        DateTime                  @default(now()) @map("created_at")

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_verifications")
}

// ═══════════════════════════════════════════════════════════════════════
// SANGHAM EDUCATE — Learning Path System
// ═══════════════════════════════════════════════════════════════════════

enum EducateDomain {
  AI_AUTOMATION
  ENTREPRENEURSHIP
  SALES
  LEADERSHIP
  NETWORKING
  WEALTH_FUNDAMENTALS
  BUDDHISM_MEDITATION
}

enum EducateLevel {
  EXPLORER
  LEARNER
  PRACTITIONER
  CONTRIBUTOR
  MENTOR
}

// Predefined learning paths — seeded, not user-created
model EducatePath {
  id          String        @id @default(uuid())
  slug        String        @unique
  domain      EducateDomain
  title       String
  tagline     String
  description String        @db.Text
  phases      Json          // Phase[] — predefined structure, AI fleshes out lessons
  circleTag   String?       @map("circle_tag")   // Community search tag for linked Circle
  isActive    Boolean       @default(true)        @map("is_active")
  sortOrder   Int           @default(0)           @map("sort_order")
  createdAt   DateTime      @default(now())       @map("created_at")

  enrollments EducateEnrollment[]

  @@map("educate_paths")
}

model EducateEnrollment {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  pathId          String    @map("path_id")
  enrolledAt      DateTime  @default(now())      @map("enrolled_at")
  lastActivityAt  DateTime  @default(now())      @map("last_activity_at")
  currentPhase    Int       @default(0)           @map("current_phase")
  currentLesson   Int       @default(0)           @map("current_lesson")
  percentComplete Float     @default(0)           @map("percent_complete")
  streak          Int       @default(0)

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  path            EducatePath            @relation(fields: [pathId], references: [id])
  lessonProgress  EducateLessonProgress[]

  @@unique([userId, pathId])
  @@map("educate_enrollments")
}

model EducateLessonProgress {
  id           String   @id @default(uuid())
  enrollmentId String   @map("enrollment_id")
  lessonKey    String   @map("lesson_key")    // "{phaseIdx}.{lessonIdx}" e.g. "0.2"
  completedAt  DateTime @default(now())       @map("completed_at")
  exerciseDone Boolean  @default(false)       @map("exercise_done")

  enrollment   EducateEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonKey])
  @@map("educate_lesson_progress")
}

model EducateUserReputation {
  id             String       @id @default(uuid())
  userId         String       @unique @map("user_id")
  level          EducateLevel @default(EXPLORER)
  totalLessons   Int          @default(0)  @map("total_lessons")
  totalPaths     Int          @default(0)  @map("total_paths")
  totalExercises Int          @default(0)  @map("total_exercises")
  longestStreak  Int          @default(0)  @map("longest_streak")
  updatedAt      DateTime     @updatedAt   @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("educate_user_reputation")
}
